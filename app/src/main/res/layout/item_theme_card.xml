<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/theme_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#22FFFFFF"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Theme Color Swatch Preview Circle / Rounded Box -->
        <LinearLayout
            android:id="@+id/theme_swatch_box"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:background="@drawable/button_background_rounded"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/swatch_key"
                android:layout_width="28dp"
                android:layout_height="14dp"
                android:layout_marginBottom="4dp" />

            <View
                android:id="@+id/swatch_accent"
                android:layout_width="28dp"
                android:layout_height="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:layout_toStartOf="@+id/theme_action_holder"
            android:layout_toEndOf="@+id/theme_swatch_box"
            android:orientation="vertical">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/theme_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Theme Name"
                android:textSize="16sp"
                android:textStyle="bold" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/theme_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Author • Built-in"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/theme_action_holder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/theme_active_badge"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_check_vector"
                android:visibility="gone"
                app:tint="@color/color_primary" />

            <ImageView
                android:id="@+id/theme_delete_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:src="@drawable/ic_delete_vector"
                android:visibility="gone"
                app:tint="#FF5252" />
        </LinearLayout>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
