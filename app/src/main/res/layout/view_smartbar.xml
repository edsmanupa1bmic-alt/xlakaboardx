<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/utility_bar_layout"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <!-- En / Si Language Switch Chip -->
        <FrameLayout
            android:id="@+id/smartbar_btn_language"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circular_chip"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/smartbar_language_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="En"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Emoji Chip -->
        <ImageView
            android:id="@+id/smartbar_btn_emoji"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circular_chip"
            android:clickable="true"
            android:contentDescription="@string/emojis"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_emoji_emotions_outline_vector"
            app:tint="#FFFFFF" />

        <!-- Tools / Settings Cog Chip -->
        <ImageView
            android:id="@+id/smartbar_btn_tools"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circular_chip"
            android:clickable="true"
            android:contentDescription="@string/settings"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_grid_view_vector"
            app:tint="#FFFFFF" />

        <!-- Aa Format / Case Chip -->
        <FrameLayout
            android:id="@+id/smartbar_btn_case"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circular_chip"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Aa"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Voice / Mic Chip -->
        <ImageView
            android:id="@+id/smartbar_btn_voice"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circular_chip"
            android:clickable="true"
            android:contentDescription="@string/switch_to_voice_typing"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_microphone_vector"
            app:tint="#FFFFFF" />

        <!-- Clipboard Chip -->
        <ImageView
            android:id="@+id/smartbar_btn_clipboard"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circular_chip"
            android:clickable="true"
            android:contentDescription="@string/clipboard"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_clipboard_vector"
            app:tint="#FFFFFF" />

        <!-- Clear / Collapse Chip -->
        <ImageView
            android:id="@+id/smartbar_btn_collapse"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circular_chip"
            android:clickable="true"
            android:contentDescription="@string/close"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_keyboard_arrow_down_vector"
            app:tint="#FFFFFF" />

    </LinearLayout>
</HorizontalScrollView>
