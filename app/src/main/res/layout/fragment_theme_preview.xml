<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/theme_preview_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- Drag handle -->
            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/ripple_all_corners_medium"
                android:backgroundTint="#44FFFFFF" />

            <!-- Title & Author Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/preview_dialog_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Theme Preview"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/preview_dialog_author"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="By FlorisBoard • Parsed Stylesheet"
                        android:textColor="#A0A0A0"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/preview_dialog_close"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cancel"
                    android:padding="8dp"
                    android:src="@drawable/ic_delete_vector"
                    app:tint="#A0A0A0" />
            </LinearLayout>

            <!-- Keyboard Mockup Container -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/mockup_keyboard_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#0A195E"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Mockup Smartbar Toolbar -->
                    <LinearLayout
                        android:id="@+id/mockup_smartbar"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp">

                        <TextView
                            android:id="@+id/mockup_chip1"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginEnd="6dp"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:text="ඔබට"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/mockup_chip2"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_marginEnd="6dp"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:text="ස්තුතියි"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/mockup_chip3"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:text="සුබ දවසක්"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Mockup Row 1 (Q - P) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginBottom="4dp"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/mock_key_q" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="q" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_w" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="w" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_e" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="e" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_r" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="r" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_t" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="t" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_y" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="y" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_u" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="u" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_i" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="i" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_o" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="o" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_p" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="p" android:textSize="16sp" />
                    </LinearLayout>

                    <!-- Mockup Row 2 (A - L) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginBottom="4dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <TextView android:id="@+id/mock_key_a" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="a" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_s" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="s" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_d" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="d" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_f" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="f" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_g" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="g" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_h" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="h" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_j" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="j" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_k" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="k" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_l" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="l" android:textSize="16sp" />
                    </LinearLayout>

                    <!-- Mockup Row 3 (Shift, Z - M, Delete) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginBottom="4dp"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/mock_key_shift" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1.4" android:gravity="center" android:text="⇧" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_z" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="z" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_x" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="x" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_c" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="c" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_v" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="v" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_b" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="b" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_n" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="n" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_m" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1" android:gravity="center" android:text="m" android:textSize="16sp" />
                        <TextView android:id="@+id/mock_key_delete" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1.5dp" android:layout_weight="1.4" android:gravity="center" android:text="⌫" android:textSize="16sp" />
                    </LinearLayout>

                    <!-- Mockup Row 4 (?123, Space, Enter) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/mock_key_symbols"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="1.5dp"
                            android:layout_weight="1.4"
                            android:gravity="center"
                            android:text="\\?123"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/mock_key_emoji"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="1.5dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="😀"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/mock_key_space"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="1.5dp"
                            android:layout_weight="4"
                            android:gravity="center"
                            android:text="English (US)"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/mock_key_enter"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="1.5dp"
                            android:layout_weight="1.8"
                            android:gravity="center"
                            android:text="↵"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Color Palette Summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/ripple_all_corners_medium"
                android:backgroundTint="#1AFFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/palette_bg"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/candidate_chip_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Backdrop"
                        android:textColor="#C0C0C0"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/palette_key"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/candidate_chip_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Key"
                        android:textColor="#C0C0C0"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/palette_accent"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/candidate_chip_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Accent"
                        android:textColor="#C0C0C0"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/palette_text"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/candidate_chip_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Text"
                        android:textColor="#C0C0C0"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/preview_btn_cancel"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/cancel"
                    android:textColor="@android:color/white"
                    app:strokeColor="#44FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/preview_btn_apply"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.4"
                    android:text="@string/apply_theme"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
